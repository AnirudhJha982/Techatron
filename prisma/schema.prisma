generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  phoneNumber  String   @unique
  passwordHash String
  role         String   @default("FARMER") // "FARMER", "WORKER", "ADMIN"
  language     String   @default("en")
  
  farmerProfile FarmerProfile?
  workerProfile WorkerProfile?
  adminProfile  AdminProfile?
  
  grievances    Grievance[]
  notifications Notification[]
  auditLogs     AuditLog[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FarmerProfile {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @unique @db.ObjectId
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address       String?
  village       String?
  district      String?
  state         String?
  landSizeAcres Float?
  
  bookings      Booking[]
}

model WorkerProfile {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  userId       String            @unique @db.ObjectId
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  centreId     String            @db.ObjectId
  centre       ProcurementCentre @relation(fields: [centreId], references: [id])
  
  procurements Procurement[]
}

model AdminProfile {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  userId     String  @unique @db.ObjectId
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  department String?
}

model ProcurementCentre {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  state          String
  district       String
  address        String
  capacityPerDay Int
  isActive       Boolean  @default(true)
  
  workers        WorkerProfile[]
  slots          Slot[]
  bookings       Booking[]
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Slot {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  centreId String   @db.ObjectId
  date     DateTime
  timeSlot String   // e.g. "08:00-10:00"
  capacity Int
  
  centre   ProcurementCentre @relation(fields: [centreId], references: [id], onDelete: Cascade)
  bookings Booking[]
  
  @@unique([centreId, date, timeSlot])
}

model Booking {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  farmerId      String   @db.ObjectId
  centreId      String   @db.ObjectId
  slotId        String   @db.ObjectId
  date          DateTime
  tokenNumber   String   @unique
  queuePosition Int?
  status        String   @default("SCHEDULED") // SCHEDULED, ARRIVED, PROCESSING, COMPLETED, CANCELLED
  
  farmer        FarmerProfile     @relation(fields: [farmerId], references: [id])
  centre        ProcurementCentre @relation(fields: [centreId], references: [id])
  slot          Slot              @relation(fields: [slotId], references: [id])
  procurement   Procurement?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Procurement {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  bookingId     String   @unique @db.ObjectId
  workerId      String   @db.ObjectId
  crop          String
  quantity      Float
  qualityGrade  String
  moistureLevel Float?
  status        String   @default("PENDING")
  paymentStatus String   @default("PENDING")
  remarks       String?
  
  booking       Booking       @relation(fields: [bookingId], references: [id])
  worker        WorkerProfile @relation(fields: [workerId], references: [id])
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Grievance {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  category    String
  description String
  status      String   @default("SUBMITTED")
  response    String?
  
  user        User     @relation(fields: [userId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  title     String
  message   String
  category  String
  isRead    Boolean  @default(false)
  
  user      User     @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  action    String
  details   String
  
  user      User?    @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now())
}
